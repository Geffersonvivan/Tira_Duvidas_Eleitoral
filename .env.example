# Copie para .env e preencha. NUNCA versione o .env real.
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Em produção (Railway): DJANGO_DEBUG=False. O domínio da Railway
# (RAILWAY_PUBLIC_DOMAIN) é liberado automaticamente em ALLOWED_HOSTS/CSRF.
# Para domínio próprio, liste aqui e em DJANGO_CSRF_TRUSTED_ORIGINS:
# DJANGO_ALLOWED_HOSTS=meudominio.com.br
# DJANGO_CSRF_TRUSTED_ORIGINS=https://meudominio.com.br

# Banco (Postgres + pgvector)
DATABASE_URL=postgres://user:pass@localhost:5432/tira_duvidas

# Claude / Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Embeddings do RAG (Voyage AI — dim 1024 = voyage-3, casa com EMBEDDING_DIM)
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=pa-...
VOYAGE_MODEL=voyage-3

# Roteamento de modelos por complexidade (§13 da lógica)
# IDs sem sufixo de data (regra da skill claude-api).
MODEL_CLASSIFY=claude-haiku-4-5
MODEL_ANSWER=claude-sonnet-4-6
MODEL_VISION=claude-sonnet-4-6
MODEL_COMPLEX=claude-opus-4-8

# Auth (Clerk) — login/logout. Sem estas chaves o site fica público (login OFF).
# Instância própria do TDE (independente do PJARI). Dev: Google funciona com as
# credenciais compartilhadas do Clerk; produção exige OAuth próprio no Google Cloud.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Orçamento (cost-aware-llm-pipeline)
# Teto mensal em USD. Agora é APLICADO antes de cada chamada: estourou o mês,
# os endpoints de LLM retornam 503 até virar o mês. 0 = sem teto.
LLM_MONTHLY_BUDGET_USD=200
LLM_MAX_RETRIES=2
# Preços por 1M de tokens (entrada,saída) — preencher a partir do console de billing.
# Ex.: PRECO_claude-sonnet-4-6=3.00,15.00
# (deixe em branco para custo 0 até confirmar os valores reais)

# Rate limit por usuário (ou IP no público) nos endpoints de LLM — req/min.
# 0 desliga. Obs.: com o cache padrão o teto é por worker do gunicorn; para um
# teto global entre workers, configurar um cache compartilhado (Redis).
RATE_LIMIT_PERGUNTAS_POR_MIN=20
RATE_LIMIT_MATERIAIS_POR_MIN=8

# RAG · corte de relevância na recuperação — distância de cosseno máxima
# (0=idêntico … 2=oposto). Vazio = desligado. Calibrar com o golden set antes
# de ativar (valor baixo demais derruba contexto útil).
RAG_DISTANCIA_MAX=

# LGPD · retenção (comando `expurgar_dados`; agende no cron). 0 = desligado.
LGPD_RETENCAO_PERGUNTAS_DIAS=0
LGPD_RETENCAO_CONVERSAS_DIAS=0

# Observabilidade — Sentry (ativo só com DSN definido e DEBUG=False).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
